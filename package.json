{
  "name": "loujc-academic-homepage",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "description": "Jincheng Lou's academic homepage built with HugoBlox",
  "scripts": {
    "dev": "hugo server --disableFastRender",
    "build": "hugo --cleanDestinationDir --minify && pnpm run pagefind",
    "calendar:generate": "node scripts/generate-busy-calendar.mjs",
    "calendar:test": "node --test scripts/availability-scheduling.test.mjs scripts/generate-busy-calendar.test.mjs scripts/icloud-caldav.test.mjs scripts/idea-snapshot.test.mjs",
    "pagefind": "pagefind --site public"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "@tailwindcss/typography": "^0.5.10",
    "pagefind": "^1.4.0",
    "preact": "^10.27.2",
    "tailwindcss": "^4.1.12"
  },
  "devDependencies": {
    "luxon": "3.7.2",
    "node-ical": "0.26.1",
    "saxes": "6.0.0"
  }
}
